# Startup loads ${LEGACY_BACKEND_ROOT}/.env first (Firebase FIREBASE_API_KEY, etc.), then this file.
LEGACY_BACKEND_ROOT=/Users/jeffren/Documents/hermes/ai-doctor-agent_legacy/backend
MCP_ALLOWED_USER_IDS=
MCP_MAX_CONTEXT_CHARS=8000
MCP_HEALTH_FALLBACK_MESSAGE=抱歉，我暂时无法加载您的个人健康档案。请稍后重试，或先完善基础档案后再咨询。

# M5 — daily report webhook (see hermes/DAILY_REPORT_RUNBOOK.md)
# trigger-node-daily-report.sh auto-sources this file unless DOCTOR_AGENT_SKIP_BRIDGE_ENV=1
# DOCTOR_AGENT_DAILY_WEBHOOK_URL=https://YOUR-RAILWAY-HOST/internal/cron/daily-report
# DOCTOR_AGENT_DAILY_WEBHOOK_TOKEN=same-as-backend-INTERNAL_CRON_BEARER_TOKEN
# Optional: comma-separated emails → JSON userEmails (overrides default payload)
# DOCTOR_AGENT_DAILY_USER_EMAILS=jianfengren.sd@gmail.com
# Optional full JSON when USER_EMAILS unset:
# DOCTOR_AGENT_DAILY_PAYLOAD={"action":"daily-report","source":"hermes-cron"}
# DOCTOR_AGENT_DAILY_DRY_RUN=1
