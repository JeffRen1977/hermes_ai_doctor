# Shared secret: Hermes Agent validates X-Internal-Token; Node sets HERMES_AGENT_TOKEN to the same value.
INTERNAL_TOKEN=change-me-in-production

# Model id as known to Ollama (ollama list). Use a Hermes-family tag when available.
HERMES_MODEL=llama3.2

# Optional: reject /v1/chat when context and payload are both empty
REQUIRE_NON_EMPTY_CONTEXT=false
